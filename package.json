{
  "name": "ai-medical-blog",
  "version": "1.0.0",
  "private": true,
  "browserslist": {
    "production": [
      "Chrome >= 100",
      "Edge >= 100",
      "Firefox >= 100",
      "Safari >= 15.4",
      "iOS >= 15.4",
      "Android >= 100"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/verify-env.js && next build",
    "start": "next start",
    "lint": "next lint",
    "verify-env": "node scripts/verify-env.js",
    "test": "jest --watch",
    "test:all": "jest --ci && playwright test",
    "test:ci": "jest --ci --coverage",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:api": "jest --testPathPattern=__tests__/api",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-test-advanced.js",
    "test:performance": "node scripts/performance-test.js",
    "test:reports": "cmd /c scripts\\generate-reports.bat",
    "test:sendgrid": "node scripts/test-sendgrid.js",
    "load-test": "node scripts/simple-load-test.js",
    "load-test:full": "node scripts/load-test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.18.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-slot": "^1.0.2",
    "@sgratzl/chartjs-chart-boxplot": "^4.4.5",
    "@types/marked": "^5.0.2",
    "canvas": "^3.2.1",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "class-variance-authority": "^0.7.0",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.0.0",
    "js-cookie": "^3.0.5",
    "lru-cache": "^11.5.1",
    "lucide-react": "^0.331.0",
    "marked": "^17.0.3",
    "mongodb": "^7.0.0",
    "next": "^14.2.21",
    "next-cloudinary": "^6.17.5",
    "openai": "^4.28.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.50.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "sharp": "^0.33.2",
    "slugify": "^1.6.6",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^29.5.11",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.11.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autocannon": "^7.15.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.21",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.5",
    "postcss": "^8.4.35",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
